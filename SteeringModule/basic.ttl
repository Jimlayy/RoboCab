; Packet parameters
header  = $AA
len     = 6
msg_id  = 1
dir     = 1
brk     = 1
spd     = $F8
servo   = 1500

; Split 16-bit servo value into high and low bytes (1500 = 0x05DC)
servo_hi = (servo >> 8) and $FF   ; 0x05 (5)
servo_lo = servo and $FF          ; 0xDC (220)

; 8-bit XOR checksum across payload bytes (result = 0xD8 / 216)
checksum = (msg_id xor dir xor brk xor spd xor servo_hi xor servo_lo) and $FF

; Send Big-Endian (MSB first): AA 01 01 01 05 DC D8
send header len msg_id dir brk spd servo_hi servo_lo checksum

; For Little-Endian (LSB first), comment out the line above and use:
; send header msg_id dir brk servo_lo servo_hi checksum